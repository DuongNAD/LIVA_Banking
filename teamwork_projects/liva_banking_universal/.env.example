# ==============================================================================
# LIVA Banking Universal — Environment Variables Template
# ==============================================================================

# Backend API server port
PORT=3001

# Operational environment (development | test | production)
NODE_ENV=development

# Cryptographic secret for signing JWT tokens (min 256-bit entropy recommended)
# Leave empty in local dev to enable automatic ephemeral key generation with dev warning
JWT_SECRET=

# Local AI inference endpoint for Copilot & AML surveillance
LOCAL_AI_ENDPOINT=http://127.0.0.1:8000/v1
LOCAL_AI_MODEL=qwen-14b
