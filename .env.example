# ==============================================================================
# LIVA Banking Harness — Master Environment Configuration Template
# ==============================================================================
# Copy this template to .env for local configuration.
# NOTE: .env is strictly ignored by Git (.gitignore) to prevent accidental secret leakage.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ngrok Remote Access & Ingress Tunneling
# ------------------------------------------------------------------------------
# Your personal or corporate ngrok authtoken.
# Obtain from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: Custom domain assigned on ngrok dashboard (e.g. your-org.ngrok-free.app)
# If left empty, ngrok will assign a dynamic ephemeral public endpoint.
NGROK_DOMAIN=

# Upstream port where Treasury Workbench is listening (5173: Vite Dev, 4173: Preview, 8080: Gateway)
NGROK_UPSTREAM_PORT=5173

# ------------------------------------------------------------------------------
# 2. Banking Universal Server & Security Gateway
# ------------------------------------------------------------------------------
# Centralized JWT secret key for signing officer session tokens (HMAC-SHA256).
# For production/multi-node deployments, provide a 64-character hexadecimal key:
# e.g., generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In local development, if omitted, server generates a secure ephemeral key per session.
JWT_SECRET=

# Centralized Banking Universal backend server port (default: 3001)
PORT=3001

# Operational Environment: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. LIVA Native Core — Path & Hardware Resource Configuration
# ------------------------------------------------------------------------------
# Storage directory for local GGUF / ONNX models (replaces legacy hardcoded E:\AI_Models)
# Example: C:\LIVA_Models or %LOCALAPPDATA%\LIVA\models
LIVA_MODELS_DIR=

# Comma-separated list of additional allowed WebSocket origins for Gateway IPC
# Example: https://treasury.internal.bank.vn,https://my-tunnel.ngrok-free.app
LIVA_WS_ALLOWED_ORIGINS=

# Encryption key override for fact database encryption (Defaults to Windows DPAPI if unset)
# LIVA_ENCRYPTION_KEY=
